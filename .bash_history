cd /mnt/e/career_boot_camp/
clear
echo "# career_boot_camp" >> README.md
git init
git add README.md
sudo unmount /mnt/e
sudo u\mount /mnt/e
sudo umount /mnt/e
cd /mnt/e/career_boot_camp/
lsof +D /mnt/e 2>/dev/null
fuser -vm /mnt/e
wsl --shutdown
